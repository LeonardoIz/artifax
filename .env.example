# Copy to .env for local development. Never commit .env.
ARTIFAX_BASE_URL=http://localhost:8080
ARTIFAX_LISTEN=:8080
ARTIFAX_DATA_DIR=./data
ARTIFAX_MAX_UPLOAD_MB=25
ARTIFAX_BOOTSTRAP_TOKEN=ax_local_dev_bootstrap_token

# basic | sso | (empty = no admin)
AUTH_MODE=basic
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# AUTH_MODE=sso
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=artifax
OIDC_CLIENT_SECRET=
ADMIN_GROUPS=admins

SESSION_TTL=168h
